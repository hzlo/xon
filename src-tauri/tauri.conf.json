{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xon",
  "version": "0.1.1",
  "identifier": "xon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:19420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XON",
        "width": 1280,
        "height": 720,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQTMzQUJCQ0I0ODhEQUQKUldTdGpVakx1enFqdkhERVpXaVFlbDJUcjlWRGRPSUF3YWFxZHdnd1N4TDVaZTJvSzE0enRKSkoK",
      "endpoints": [
        "https://github.com/hzlo/xon/releases/latest/download/latest.json"
      ]
    }
  }
}
